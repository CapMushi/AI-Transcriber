**Implementation Pattern:**
```typescript
// State initialization
const [primaryFiles, setPrimaryFiles] = useState<FileInfo[]>([])
const [localTranscriptions, setLocalTranscriptions] = useState<Map<string, TranscriptionResponse>>(new Map())

// Multiple file upload
const uploadPrimaryFiles = useCallback(async (files: File[]): Promise<boolean> => {
  const uploadedFiles: FileInfo[] = []
  
  for (const file of files) {
    const success = await uploadFile(file)
    if (success && uploadedFile) {
      uploadedFiles.push(uploadedFile)
    }
  }
  
  setPrimaryFiles(uploadedFiles)
  return uploadedFiles.length > 0
}, [uploadFile])

// Store multiple files
const storeMultiplePrimaryContent = useCallback(async (model?: string, language?: string): Promise<boolean> => {
  if (primaryFiles.length === 0) return false
  
  const filePaths = primaryFiles.map(f => f.file_path)
  const originalFilenames = primaryFiles.map(f => f.original_name)
  
  const response = await apiService.storeMultiplePrimaryContent(
    filePaths,
    originalFilenames,
    model || selectedModel,
    language || 'auto'
  )
  
  if (response.success) {
    // Store transcriptions locally (NOT display)
    const transcriptions = new Map<string, TranscriptionResponse>()
    response.transcriptions.forEach((transcription, filename) => {
      transcriptions.set(filename, transcription)
    })
    setLocalTranscriptions(transcriptions)
  }
  
  return response.success
}, [primaryFiles, selectedModel])
```

### **Backend API Implementation**

#### **File: [api/routes/transcribe.py](mdc:api/routes/transcribe.py)**

**New Request/Response Models:**
```python
class StoreMultiplePrimaryRequest(BaseModel):
    file_paths: List[str]
    original_filenames: List[str]
    model: str = "base"
    language: str = "auto"

class StoreMultiplePrimaryResponse(BaseModel):
    success: bool
    message: str
    files_processed: int
    storage_in_progress: bool
    transcriptions: Dict[str, Dict[str, Any]] = {}  # filename -> transcription data
```

**Implementation Pattern:**
```python
@router.post("/store-multiple-primary", response_model=StoreMultiplePrimaryResponse)
async def store_multiple_primary_content(request: StoreMultiplePrimaryRequest):
    try:
        # Validate files
        for file_path in request.file_paths:
            is_valid, error_msg = audio_processor.validate_file(file_path)
            if not is_valid:
                return StoreMultiplePrimaryResponse(
                    success=False,
                    message="File validation failed",
                    error=error_msg
                )
        
        # Prepare transcription tasks
        transcription_tasks = [
            (file_path, request.model, request.language, "transcribe")
            for file_path in request.file_paths
        ]
        
        # Use existing parallel transcription
        transcription_results = await _transcribe_parallel(
            transcription_tasks, 
            max_workers=len(request.file_paths)
        )
        
        # Process each transcription result
        transcriptions = {}
        total_chunks = 0
        
        for i, result in enumerate(transcription_results):
            if result.get("success", False):
                original_filename = request.original_filenames[i]
                file_path = request.file_paths[i]
                
                # Store transcription locally (for frontend)
                transcriptions[original_filename] = {
                    "text": result.get("text", ""),
                    "segments": result.get("segments", []),
                    "language": result.get("language", ""),
                    "model_used": result.get("model_used", ""),
                    "file_path": file_path
                }
                
                # Generate and upsert chunks (background)
                file_info = audio_processor.get_file_info(file_path)
                file_metadata = vector_handler.prepare_file_metadata(
                    original_filename=original_filename,
                    file_info=file_info
                )
                
                # Use existing chunk generation
                chunks = vector_handler.generate_chunks(result)
                
                # Use existing upserting (already supports parallel)
                upsert_result = await vector_handler.upsert_chunks_parallel(
                    chunks, file_metadata
                )
                
                if upsert_result.get("success", False):
                    total_chunks += upsert_result.get("chunks_stored", 0)
        
        return StoreMultiplePrimaryResponse(
            success=True,
            message=f"Successfully processed {len(transcriptions)} files",
            files_processed=len(transcriptions),
            storage_in_progress=True,
            transcriptions=transcriptions
        )
        
    except Exception as e:
        return StoreMultiplePrimaryResponse(
            success=False,
            message="Store multiple primary failed",
            error=str(e)
        )
```

